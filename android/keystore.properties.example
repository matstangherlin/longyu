# RC2.2.10 — MODELO sem segredos. Copie para android/keystore.properties
# (gitignored) SOMENTE na sua máquina. Nunca commite o arquivo real.
# Alternativa preferida: variáveis de ambiente
#   LONGYU_ANDROID_KEYSTORE_PATH / LONGYU_ANDROID_KEYSTORE_PASSWORD /
#   LONGYU_ANDROID_KEY_ALIAS / LONGYU_ANDROID_KEY_PASSWORD
# Caminho relativo é resolvido a partir de android/. Guarde a .jks FORA do repo.
# Guia completo: docs/ANDROID_SIGNING.md
storeFile=/secure/path/to/longyu-upload.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
